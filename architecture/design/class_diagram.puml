@startuml class_diagram
' =============================================================================
' CAEGraph - Design UML (Class Diagram)
' =============================================================================
' PURPOSE : "Planned design" - the domain abstractions of CAEGraph.
' OWNER   : Architecture Agent
' RULES   :
'   - Update this diagram BEFORE implementing code.
'   - Show abstractions, responsibilities and relationships.
'   - Do NOT enumerate concrete method signatures; that is Generated UML's job.
' GUIDE   : see architecture/UML_GUIDE.md
' =============================================================================

title CAEGraph Domain Abstractions (Design) - ADR-007/008/009/015-018

package "external ecosystem bases" {
  class "torch_geometric.data.Data" as PyGData <<external>>
  abstract class "torch_geometric.data.Dataset" as PyGDataset <<external>>
  abstract class "torch.nn.Module" as TorchModule <<external>>
}

package "caegraph.core (domain truth: CAEGraph + topology subsystem; torch-only, never PyG)" {
  abstract class BaseObject {
    Base abstraction: identity, metadata, validation contract
  }
  class Registry {
    Name-keyed registry/factory for loaders and
    transforms (register / get / build);
    duplicate names rejected (Phase 1);
    name->factory only, callable check is the
    contract; runtime type enforcement
    (base_class + issubclass) recorded as a
    future option, deliberately not Phase 1
  }
  class CAEGraph {
    Graph-native canonical domain
    representation (ADR-015).
    Semantic composition (ADR-018):
    entities, relations, geometry,
    fields, regions, conditions;
    topology subsystem is an optional
    semantic provider referenced by
    CAEGraph - present for cell-based,
    absent for mesh-free (ADR-014).
    Semantic composition does not
    define class members or storage
    layout. Never imports PyG -
    PyG / networkx / igraph are
    backends or analysis engines,
    never the domain model
  }
  class Field {
    Named field data: values, unit, timestep,
    node-or-cell association (ADR-007 D6)
  }
  enum BoundaryType {
    Mathematical BC categories (ADR-010):
    DIRICHLET / NEUMANN / ROBIN /
    PERIODIC / SYMMETRY / INTERFACE / NONE;
    software-specific names (wall, inlet...)
    live in BoundaryRegion metadata, never here.
    NOTE: single enum holds constraint types AND
    topological roles; re-evaluated in ADR-011:
    kept single through Phase 2, hardened by
    BoundarySpec slot-coherence validation;
    orthogonal role x constraint axes deferred
    until Phase 3 evidence (re-trigger
    conditions in ADR-011)
  }
  enum NodeCategory {
    INTERIOR / BOUNDARY / CORNER
  }
  class BoundaryManager {
    Semantic region registry (ADR-018):
    name -> BoundaryRegion, spec binding
    by name resolution, corner
    (multi-region) queries; references
    topology, does not own it
  }
  class BoundaryRegion {
    Semantic region (ADR-018): membership
    is represented according to the
    source discretization; cell-based:
    dim == topo_dim - 1, membership =
    canonical topology identifiers
    (global facet IDs, node sets as
    derived views, ADR-014); references
    topology, does not own it; targetable
    by BoundarySpec by name; carries
    software naming metadata per
    ADR-010; BaseObject domain-truth family
  }
  class BoundarySpec {
    User-facing boundary declaration: type, value,
    weight, space/time dependence;
    paired_region slot for PERIODIC,
    generic parameters container for ROBIN
    (design slots, Phase 2 contract, ADR-010);
    per-type slot-coherence validation
    required, fail-fast (ADR-011)
  }
  abstract class FieldFunction {
    Callable analytic boundary/initial value:
    (t, pos) -> tensors, shape self-validation
  }

  package "caegraph.core.topology (topology subsystem - optional semantic provider, first-class for cell-based discretizations, ADR-014/018)" {
    class Mesh {
      Topology-rich discretization
      representation (ADR-015): one
      cell-based topology representation
      supported by the topology subsystem
      (FEM/FVM); nodes (n,3) + topo_dim;
      cells CSR (int-coded cell_types /
      connectivity / offsets, single truth,
      type views derived only); explicit
      facets CSR + validated ragged
      facet_cells (winding-free); domain
      groups (plain global-cell-id data);
      structure frozen after validate
      (ADR-014)
    }
    enum CellType {
      LINE2 / TRI3 / QUAD4 / TET4 / PYR5 /
      WEDGE6 / HEX8 (POINT + higher-order =
      future); explicit stable integer codes,
      never enum-declaration order; dim,
      node_count, CAEGraph local-node
      convention + codim-1 face templates
      (frozen with implementation, ADR-014)
    }
  }
}

package "caegraph.geometry" {
  class GeometryProcessor {
    Geometric services: edge features
    (distance, direction, normal, quality),
    field interpolation
  }
}

package "caegraph.io" {
  abstract class MeshLoader {
    Cross-format loading pipeline
    (ADR-012): __call__(path) -> Mesh is
    stable; per-format protected hooks are
    implementation details, not frozen;
    parse source format, then produce
    topology input per ADR-014 (incl.
    explicit facets + validated
    facet-cell adjacency); source named
    groups classified by dim vs topo dim
    into domain / boundary-interface
    group metadata (ADR-012 - preserved
    for downstream region construction;
    lower-dim groups -> diagnostics);
    IO never infers BoundaryType - math
    categories come from user specs only
  }
  class GmshLoader {
    First concrete MeshLoader for gmsh
    source named groups via meshio
    (provisional engine, ADR-013; types
    never leak past io); performs the
    ADR-012 normalization obligations per
    ADR-014 (block-local ids, local-node
    convention, facet winding, group
    representation)
  }
  interface MeshWriter {
    Write-back into the CAE ecosystem;
    VTK / ParaView first
  }
}

package "caegraph.graph (representation construction + backend adapter)" {
  abstract class RepresentationBuilder {
    Source discretization -> CAEGraph
    entities + relations (ADR-015);
    extension point (ADR-016) -
    specializations per source
    discretization family (mesh /
    grid / particles follow separate
    construction strategies);
    API/class names/registry/layout
    not frozen; replaces the single
    Mesh -> GraphBuilder contract (ADR-009)
  }
  class BackendAdapter {
    CAEGraph -> framework-specific
    graph representation;
    PyG Data is the Phase 2 form;
    DataGraph is a conceptual backend
    representation layer, not a required
    class, never the domain graph
    object (ADR-017); concrete
    interface not frozen
  }
}

package "caegraph.transforms" {
  class GeometryTransform {
    Coordinate / feature normalization
  }
  class FeatureTransform {
    CAE feature engineering on
    backend graph representation
  }
  class PhysicsTransform {
    Boundary-condition encoding:
    data.x[data.inlet_mask] = value pattern
    (BC application lives HERE,
    not on the domain object)
  }
}

package "caegraph.dataset" {
  class CAEDataset {
    Collections, transforms, splits;
    backend-specific (ADR-009)
  }
}

package "caegraph.physics" {
  class PhysicsLoss {
    PDE residuals / physics-informed loss terms
  }
}

package "caegraph.models (interface + utilities, no GNN zoo)" {
  abstract class Model {
    GNN model abstraction:
    encode - process - decode contract;
    backend-specific (ADR-009);
    concrete architectures (MeshGraphNet/GNO/...)
    live in examples / external projects (ADR-008)
  }
}

package "caegraph.assimilation" {
  class Observation {
    Observation operators: sparse measurements
    (e.g. PIV) on graph fields
  }
  class Correction {
    Correction operators: dense prediction +
    observation -> improved field
  }
}

package "caegraph.workflow (training utilities, no fit loop)" {
  class LossAssembly {
    Compose data + physics + observation
    loss terms (consumes assimilation, physics)
  }
  class BatchAdaptation {
    CAE-aware batching helpers
  }
}

package "caegraph.inference (neural simulation harness)" {
  class Simulator {
    CAEGraph (any discretization) +
    pretrained model -> fields;
    backend data -> forward ->
    field reconstruction
  }
  class Rollout {
    Transient rollout LOOP harness;
    numerical schemes stay model-side (ADR-007 D5)
  }
}

' --- Relationships -----------------------------------------------------------

BaseObject <|-- CAEGraph
BaseObject <|-- Mesh
BaseObject <|-- Field
BaseObject <|-- BoundaryRegion
MeshLoader <|-- GmshLoader

CAEDataset ..> PyGDataset : Phase 2 implementation binding (ADR-009)
Model ..> TorchModule : Phase 2 implementation binding (ADR-009)

BoundaryManager "1" o-- "*" BoundaryRegion : registers
BoundaryManager "1" o-- "*" BoundarySpec : binds
BoundarySpec --> BoundaryType : typed by
BoundarySpec "*" o--> "0..1" BoundaryRegion : targets by name
BoundarySpec "*" o--> "0..1" FieldFunction : optional value
CAEGraph ..> Field : associated semantic data (ADR-018)
CAEGraph ..> Mesh : cell-based topology example (optional semantic provider; ADR-014/018)
CAEGraph ..> BoundaryManager : uses semantic regions
CAEGraph ..> NodeCategory : entity annotation

MeshLoader ..> Mesh : produces topology input
MeshWriter ..> Mesh : consumes
RepresentationBuilder ..> Mesh : cell-based source example (ADR-016)
RepresentationBuilder ..> GeometryProcessor : uses features
RepresentationBuilder ..> CAEGraph : produces
BackendAdapter ..> CAEGraph : consumes
BackendAdapter ..> PyGData : Phase 2 backend example (produces)
GeometryTransform ..> PyGData : operates on
FeatureTransform ..> PyGData : operates on
PhysicsTransform ..> PyGData : operates on
CAEDataset ..> PyGData : consumes (Phase 2)
Model ..> PhysicsLoss : may consume
CAEDataset "1" --> "*" Model : provides data for

LossAssembly ..> PhysicsLoss : composes
LossAssembly ..> Observation : composes (training-constraint mode)
Rollout ..> Model : calls
Simulator ..> Rollout : orchestrates
Simulator ..> MeshWriter : exports results
Correction ..> Observation : uses (post-inference mode)

note right of BackendAdapter
  Positioning (ADR-008, clarified by
  ADR-015/017): no solver abstraction,
  no trainer abstraction; backend
  adapters are allowed - backend
  replacement requires architecture
  review confirming the CAEGraph
  domain boundary and dependency
  direction remain unchanged (ADR-017).
end note

@enduml
