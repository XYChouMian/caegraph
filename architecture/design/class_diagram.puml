@startuml class_diagram
' =============================================================================
' CAEGraph - Design UML (Class Diagram)
' =============================================================================
' PURPOSE : "Planned design" - the domain abstractions of CAEGraph.
' OWNER   : Architecture Agent
' RULES   :
'   - Update this diagram BEFORE implementing code.
'   - Show abstractions, responsibilities and relationships.
'   - Do NOT enumerate concrete method signatures; that is Generated UML's job.
' GUIDE   : see architecture/UML_GUIDE.md
' =============================================================================

title CAEGraph Domain Abstractions (Design) - seven abstractions per ADR-007

package "caegraph.core (domain core; torch-only, never PyG)" {
  abstract class BaseObject {
    Base abstraction: identity, metadata, validation contract
  }
  class Mesh {
    CAE discrete geometry object: nodes, elements,
    faces, boundary regions;
    composed of geometry / topology / boundary / fields
    (anti god-object, ADR-007 D3)
  }
  class Graph {
    Domain-level graph abstraction with tensor storage:
    nodes, edges, node categories, boundary masks;
    dumb container + schema validation;
    NOT bound to any GNN framework (ADR-007 D1)
  }
  class Field {
    Named field data: values, unit, timestep,
    node-or-cell association (ADR-007 D6)
  }
  enum BoundaryType {
    DIRICHLET / NEUMANN / FREE
  }
  enum NodeCategory {
    INTERIOR / BOUNDARY / CORNER
  }
  class BoundaryManager {
    Mesh-internal registry: boundary regions from
    physical groups, spec binding, corner queries
  }
  class BoundarySpec {
    User-facing boundary declaration: type, value,
    weight, space/time dependence
  }
  abstract class FieldFunction {
    Callable analytic boundary/initial value:
    (t, pos) -> tensors, shape self-validation
  }
}

package "caegraph.geometry" {
  class GeometryProcessor {
    Geometric services: edge features
    (distance, direction, normal, quality),
    field interpolation
  }
}

package "caegraph.io" {
  interface MeshLoader {
    Format readers on the core registry;
    gmsh first (physical groups -> regions)
  }
  interface MeshWriter {
    Write-back into the CAE ecosystem;
    VTK / ParaView first
  }
}

package "caegraph.graph" {
  class GraphBuilder {
    Mesh -> Graph construction:
    node graph / cell graph views
  }
  class GraphTransform {
    Composable graph-space transformations
  }
}

package "caegraph.integrations" {
  class PyGAdapter {
    to_pyg() + PyG datasets;
    the ONLY place torch_geometric is imported
    (ADR-007 D2); future backends mirror this
  }
}

package "caegraph.dataset" {
  class Dataset {
    Collection of Graph samples with transforms,
    splits and loading semantics
  }
}

package "caegraph.physics" {
  class PhysicsLoss {
    PDE residuals / physics-informed loss terms
    (Phase 3)
  }
}

package "caegraph.models" {
  abstract class Model {
    GNN / physics-informed model abstraction:
    encode - process - decode contract
  }
  class Trainer {
    Training / evaluation / checkpoint orchestration
    for Model + Dataset
  }
}

' --- Relationships -----------------------------------------------------------

BaseObject <|-- Mesh
BaseObject <|-- Graph
BaseObject <|-- Field
BaseObject <|-- Dataset
BaseObject <|-- Model

Mesh "1" *-- "1" BoundaryManager : owns
BoundaryManager "1" o-- "*" BoundarySpec : binds
BoundarySpec --> BoundaryType : typed by
BoundarySpec "*" o--> "0..1" FieldFunction : optional value
Mesh "1" o-- "*" Field : carries
Graph ..> NodeCategory : node attribute

MeshLoader ..> Mesh : produces
MeshWriter ..> Mesh : consumes
GraphBuilder ..> Mesh : builds from
GraphBuilder ..> GeometryProcessor : uses features
Mesh "1" --> "1" Graph : to_graph() (node/cell views)
GraphTransform ..> Graph : operates on
PyGAdapter ..> Graph : converts (one-way view)
Dataset "1" o-- "*" Graph
Dataset ..> PyGAdapter : yields backend samples
Model "1" --> "1" Trainer : orchestrated by
Model ..> PhysicsLoss : may consume (Phase 3)

note right of Graph
  Solver-side orchestration (time integrators,
  rollout systems, monitors) is OUT of the
  library (ADR-007 D5) - user application land
end note

@enduml
